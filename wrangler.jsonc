{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  // Nom du Worker conserve : il porte le domaine jardinerie-marcipont.be (+ www).
  // Chaque build (Workers Builds relie a GitHub) deploie ici, de facon deterministe.
  "name": "jardinerie-marcipont",
  // Script minimal : lit l'interrupteur de maintenance du parc Scribeo, puis sert les fichiers.
  "main": "interrupteur.js",
  "compatibility_date": "2026-09-05",
  // Adresse workers.dev active aujourd'hui : on la garde (secours, parc).
  "workers_dev": true,
  // Site vitrine statique : les fichiers sont servis tels quels.
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    // Pas de fichier trouve = vraie 404 (le hors-ligne est gere par le service worker).
    "not_found_handling": "404-page",
    // Seules les pages passent par le script (quota gratuit : 100 000 requetes par jour pour
    // tout le compte). Images, icones, CSS, JS, manifeste et robots.txt sont servis directement.
    "run_worker_first": [
      "/*",
      "!/images/*",
      "!/*.png",
      "!/*.jpg",
      "!/*.svg",
      "!/*.css",
      "!/*.js",
      "!/robots.txt",
      "!/manifest.webmanifest"
    ]
  },
  // Espace KV commun du parc Scribeo : une cle par projet, "off" coupe le site.
  // Ecrit par le tableau de bord ou la conversation privee, lu par le Worker.
  "kv_namespaces": [
    { "binding": "MAINT", "id": "c45395e1f7db4e72988e90924c650d15" }
  ],
  // Liaison vers le poste de commande, pour aller chercher la page de coupure.
  // Une requete HTTP ne suffirait pas entre deux Workers du meme sous-domaine.
  "services": [
    { "binding": "OPS", "service": "scribeo-ops" }
  ]
}
